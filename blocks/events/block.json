{
	"$schema": "https://schemas.wp.org/trunk/block.json",
	"apiVersion": 3,
	"name": "openmu/events",
	"title": "Event schedule",
	"category": "widgets",
	"icon": "calendar-alt",
	"description": "Next start of the game events (Blood Castle, Devil Square, invasions...) on each game server, in the site's time zone, soonest first.",
	"keywords": [ "events", "schedule", "blood castle", "devil square" ],
	"textdomain": "openmu-wp-connect",
	"attributes": {
		"limit": { "type": "integer", "default": 10 }
	},
	"supports": { "html": false, "align": [ "wide" ] },
	"editorScript": "openmu-wp-connect-editor-extra",
	"style": [ "openmu-wp-connect-blocks", "openmu-wp-connect-blocks-extra" ],
	"render": "file:./render.php"
}
